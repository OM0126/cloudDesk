<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CloudDesk - Dashboard</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #111827;
        }

        /* =========================================
           MAIN LAYOUT
        ========================================= */

        .layout {
            display: flex;
            min-height: 100vh;
        }


        /* =========================================
           SIDEBAR
        ========================================= */

        .sidebar {
            width: 250px;
            background: #111827;
            color: white;
            padding: 25px 18px;

            display: flex;
            flex-direction: column;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;

            padding: 10px 12px;
            margin-bottom: 35px;
        }

        .logo span {
            color: #60a5fa;
        }


        .menu-title {
            font-size: 11px;
            color: #9ca3af;
            text-transform: uppercase;

            margin: 0 12px 10px;
        }


        .menu {
            list-style: none;
        }

        .menu li {
            margin-bottom: 6px;
        }

        .menu a {
            display: flex;
            align-items: center;

            gap: 12px;

            padding: 12px;

            color: #d1d5db;

            text-decoration: none;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.2s;
        }

        .menu a:hover,
        .menu a.active {
            background: #1f2937;
            color: white;
        }

        .menu-icon {
            width: 20px;
            text-align: center;
        }


        /* =========================================
           SIDEBAR BOTTOM
        ========================================= */

        .sidebar-bottom {
            margin-top: auto;
        }

        .logout {
            display: block;

            padding: 12px;

            color: #fca5a5;

            text-decoration: none;

            border-radius: 8px;

            font-size: 14px;
        }

        .logout:hover {
            background: #1f2937;
        }


        /* =========================================
           MAIN CONTENT
        ========================================= */

        .main {
            flex: 1;

            padding: 30px 40px;

            overflow-x: hidden;
        }


        /* =========================================
           TOP BAR
        ========================================= */

        .topbar {
            display: flex;

            justify-content: space-between;
            align-items: center;

            margin-bottom: 35px;
        }

        .topbar-left h1 {
            font-size: 28px;
            margin-bottom: 6px;
        }

        .topbar-left p {
            color: #6b7280;
            font-size: 14px;
        }


        .profile-mini {
            display: flex;

            align-items: center;

            gap: 12px;
        }

        .notification {
            width: 40px;
            height: 40px;

            border-radius: 50%;

            background: white;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 1px solid #e5e7eb;

            font-size: 18px;
        }


        .avatar {
            width: 42px;
            height: 42px;

            border-radius: 50%;

            background: #111827;

            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            font-weight: bold;

            text-transform: uppercase;
        }


        /* =========================================
           WELCOME CARD
        ========================================= */

        .welcome-card {
            background: #111827;

            color: white;

            border-radius: 16px;

            padding: 28px 30px;

            margin-bottom: 25px;
        }

        .welcome-card h2 {
            font-size: 23px;
            margin-bottom: 8px;
        }

        .welcome-card p {
            color: #d1d5db;
            font-size: 14px;
        }


        /* =========================================
           STAT CARDS
        ========================================= */

        .stats {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 18px;

            margin-bottom: 25px;
        }

        .stat-card {
            background: white;

            border: 1px solid #e5e7eb;

            border-radius: 14px;

            padding: 22px;

            min-height: 130px;
        }

        .stat-icon {
            font-size: 22px;

            margin-bottom: 15px;
        }

        .stat-card h3 {
            font-size: 27px;

            margin-bottom: 5px;
        }

        .stat-card p {
            color: #6b7280;

            font-size: 13px;
        }


        /* =========================================
           CONTENT GRID
        ========================================= */

        .content-grid {
            display: grid;

            grid-template-columns: 2fr 1fr;

            gap: 20px;
        }


        /* =========================================
           CARD
        ========================================= */

        .card {
            background: white;

            border: 1px solid #e5e7eb;

            border-radius: 14px;

            padding: 25px;

            margin-bottom: 20px;
        }

        .card-header {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 20px;
        }

        .card-header h2 {
            font-size: 18px;
        }

        .card-header span {
            color: #6b7280;

            font-size: 13px;
        }


        /* =========================================
           CLOUD ACCOUNT
        ========================================= */

        .cloud-account {
            display: flex;

            justify-content: space-between;

            align-items: center;

            padding: 16px;

            border: 1px solid #e5e7eb;

            border-radius: 10px;

            margin-bottom: 12px;
        }

        .cloud-left {
            display: flex;

            align-items: center;

            gap: 14px;
        }

        .cloud-icon {
            width: 42px;
            height: 42px;

            border-radius: 10px;

            background: #f3f4f6;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 20px;
        }

        .cloud-name {
            font-weight: 600;

            margin-bottom: 4px;
        }

        .cloud-info {
            color: #6b7280;

            font-size: 12px;
        }


        /* =========================================
           STATUS
        ========================================= */

        .status {
            padding: 6px 10px;

            border-radius: 20px;

            font-size: 11px;

            font-weight: 600;
        }

        .connected {
            background: #dcfce7;

            color: #166534;
        }

        .not-connected {
            background: #f3f4f6;

            color: #6b7280;
        }


        /* =========================================
           PROFILE
        ========================================= */

        .profile-row {
            display: flex;

            justify-content: space-between;

            padding: 13px 0;

            border-bottom: 1px solid #f0f0f0;
        }

        .profile-row:last-child {
            border-bottom: none;
        }

        .profile-label {
            color: #6b7280;

            font-size: 13px;
        }

        .profile-value {
            font-size: 14px;

            font-weight: 600;

            text-align: right;
        }


        /* =========================================
           ALERTS
        ========================================= */

        .alert {
            padding: 14px;

            border-radius: 10px;

            background: #fff7ed;

            border: 1px solid #fed7aa;

            margin-bottom: 10px;
        }

        .alert-title {
            font-weight: 600;

            font-size: 13px;

            margin-bottom: 4px;
        }

        .alert-message {
            color: #6b7280;

            font-size: 12px;

            line-height: 1.5;
        }

        .no-alerts {
            color: #6b7280;

            font-size: 13px;

            text-align: center;

            padding: 15px 0;
        }


        /* =========================================
           AWS DETAILS
        ========================================= */

        .aws-details {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 12px;
        }

        .aws-detail {
            background: #f9fafb;

            padding: 15px;

            border-radius: 10px;
        }

        .aws-detail small {
            display: block;

            color: #6b7280;

            font-size: 11px;

            margin-bottom: 5px;
        }

        .aws-detail strong {
            font-size: 13px;
        }


        /* =========================================
           AWS SERVICES
        ========================================= */

        .service-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .service-box {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 16px;
        }

        .service-box-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .service-box-header h4 {
            font-size: 14px;
            font-weight: 700;
        }

        .service-count {
            background: #eef2ff;
            color: #4338ca;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 20px;
        }

        .service-list {
            list-style: none;
            max-height: 150px;
            overflow-y: auto;
        }

        .service-list li {
            display: flex;
            justify-content: space-between;
            padding: 7px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 12.5px;
        }

        .service-list li:last-child {
            border-bottom: none;
        }

        .service-item-name {
            color: #111827;
            font-weight: 600;
        }

        .service-item-meta {
            color: #6b7280;
        }

        .service-empty {
            color: #9ca3af;
            font-size: 12.5px;
            padding: 6px 0;
        }

        .service-error {
            color: #b91c1c;
            font-size: 12px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            padding: 8px 10px;
            border-radius: 8px;
        }

        .state-pill {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 20px;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: capitalize;
        }

        .state-running,
        .state-available,
        .state-active,
        .state-ok {
            background: #dcfce7;
            color: #166534;
        }

        .state-stopped,
        .state-inactive,
        .state-alarm {
            background: #fee2e2;
            color: #991b1b;
        }

        .state-pending,
        .state-insufficient_data {
            background: #fef3c7;
            color: #92400e;
        }


        /* =========================================
           BUTTON
        ========================================= */

        .button {
            display: inline-block;

            background: #111827;

            color: white;

            text-decoration: none;

            padding: 11px 16px;

            border-radius: 8px;

            font-size: 13px;

            font-weight: 600;
        }

        .button:hover {
            background: #1f2937;
        }

        .disconnect-form {
            margin: 0;
        }

        .disconnect-button {
            display: inline-block;
            border: 1px solid #fecaca;
            background: #fef2f2;
            color: #b91c1c;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .disconnect-button:hover {
            background: #fee2e2;
        }


        
        /* =========================================
           AWS ACTION BUTTONS + PASSWORD MODAL
        ========================================== */

        .service-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 7px;
        }

        .service-action-btn {
            font-size: 10px;
            line-height: 1;
            padding: 5px 8px;
            border-radius: 6px;
            border: 1px solid #d1d5db;
            background: white;
            color: #374151;
            cursor: pointer;
            transition: .15s;
        }

        .service-action-btn:hover {
            background: #f9fafb;
            transform: translateY(-1px);
        }

        .service-action-success {
            border-color: #bbf7d0;
            background: #f0fdf4;
            color: #166534;
        }

        .service-action-success:hover {
            background: #dcfce7;
        }

        .service-action-danger {
            border-color: #fecaca;
            background: #fef2f2;
            color: #b91c1c;
        }

        .service-action-danger:hover {
            background: #fee2e2;
        }

        .pin-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 20px;
        }

        .pin-modal-card {
            width: 100%;
            max-width: 360px;
            background: white;
            border-radius: 14px;
            padding: 28px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, .20);
        }

        .pin-modal-card h3 {
            margin-bottom: 10px;
            font-size: 16px;
        }

        .pin-modal-desc {
            color: #6b7280;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 16px;
        }

        .pin-modal-password {
            width: 100%;
            height: 42px;
            padding: 0 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            margin-bottom: 12px;
            outline: none;
            font-size: 13px;
        }

        .pin-modal-password:focus {
            border-color: #3864c7;
            box-shadow: 0 0 0 3px rgba(56, 100, 199, .10);
        }

        .pin-modal-error {
            color: #b91c1c;
            font-size: 12px;
            min-height: 18px;
            margin-bottom: 10px;
        }

        .pin-modal-buttons {
            display: flex;
            gap: 10px;
        }

        .pin-modal-btn {
            flex: 1;
            padding: 10px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
        }

        .pin-modal-cancel {
            border: 1px solid #d1d5db;
            background: white;
            color: #374151;
        }

        .pin-modal-confirm {
            border: none;
            background: #111827;
            color: white;
        }

        .pin-modal-confirm:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

/* =========================================
           RESPONSIVE
        ========================================= */

        @media (max-width: 1100px) {

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }

            .service-grid {
                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 700px) {

            .sidebar {
                width: 70px;

                padding: 20px 10px;
            }

            .logo {
                font-size: 0;

                text-align: center;
            }

            .logo span {
                font-size: 20px;
            }

            .menu-title,
            .menu a span:not(.menu-icon),
            .logout span {
                display: none;
            }

            .menu a,
            .logout {
                justify-content: center;
            }

            .main {
                padding: 20px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .aws-details {
                grid-template-columns: 1fr;
            }

            .topbar-left h1 {
                font-size: 22px;
            }

        }

    </style>

</head>


<body>


<div class="layout">


    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <aside class="sidebar">

        <div class="logo">
            Cloud<span>Desk</span>
        </div>


        <div class="menu-title">
            Main Menu
        </div>


        <ul class="menu">

            <li>
                <a href="{% url 'dashboard' %}" class="active">
                    <span class="menu-icon">⌂</span>
                    <span>Dashboard</span>
                </a>
            </li>


            <li>
                <a href="#">
                    <span class="menu-icon">☁</span>
                    <span>Cloud Accounts</span>
                </a>
            </li>


            <li>
                <a href="#">
                    <span class="menu-icon">🔔</span>
                    <span>Alerts</span>
                </a>
            </li>


            <li>
                <a href="#">
                    <span class="menu-icon">⚙</span>
                    <span>Settings</span>
                </a>
            </li>

        </ul>


        <div class="sidebar-bottom">

            <a href="{% url 'logout' %}" class="logout">
                <span>🚪 Logout</span>
            </a>

        </div>

    </aside>



    <!-- =========================================
         MAIN
    ========================================== -->

    <main class="main">


        <!-- TOP BAR -->

        <div class="topbar">

            <div class="topbar-left">

                <h1>Dashboard</h1>

                <p>
                    Manage your cloud accounts from one place.
                </p>

            </div>


            <div class="profile-mini">

                <div class="notification">
                    🔔
                </div>


                <div class="avatar">
                    {{ profile.name|first }}
                </div>

            </div>

        </div>



        <!-- =====================================
             WELCOME
        ====================================== -->

        <div class="welcome-card">

            <h2>
                Welcome back, {{ profile.name }} 👋
            </h2>

            <p>
                You're signed in as {{ profile.email }}.
            </p>

        </div>



        <!-- =====================================
             STATISTICS
        ====================================== -->

        <div class="stats">


            <div class="stat-card">

                <div class="stat-icon">
                    ☁️
                </div>

                <h3>
                    {{ total_cloud_accounts }}
                </h3>

                <p>
                    Connected Cloud Accounts
                </p>

            </div>



            <div class="stat-card">

                <div class="stat-icon">
                    🟠
                </div>

                <h3>
                    {{ cloud_accounts.aws }}
                </h3>

                <p>
                    AWS Accounts
                </p>

            </div>





            <div class="stat-card">

                <div class="stat-icon">
                    🟢
                </div>

                <h3>
                    {{ cloud_accounts.gcp }}
                </h3>

                <p>
                    Google Cloud Accounts
                </p>

            </div>

        </div>



        <!-- =====================================
             CONTENT
        ====================================== -->

        <div class="content-grid">


            <!-- =================================
                 CLOUD ACCOUNTS
            ================================== -->

            <div>


                <div class="card">

                    <div class="card-header">

                        <h2>
                            Cloud Accounts
                        </h2>

                        <span>
                            {{ total_cloud_accounts }} connected
                        </span>

                    </div>



                    <!-- AWS -->

                    <div class="cloud-account">

                        <div class="cloud-left">

                            <div class="cloud-icon">
                                ☁️
                            </div>


                            <div>

                                <div class="cloud-name">
                                    Amazon Web Services
                                </div>

                                {% if aws_connection %}

                                    <div class="cloud-info">

                                        Account ID:
                                        {{ aws_connection.account_id }}

                                        <br>

                                        Region:
                                        {{ aws_connection.region }}

                                    </div>

                                {% else %}

                                    <div class="cloud-info">
                                        No AWS account connected.
                                    </div>

                                {% endif %}

                            </div>

                        </div>


                        {% if aws_connection %}

                            <form
                                method="post"
                                action="{% url 'aws_disconnect' %}"
                                class="disconnect-form"
                                onsubmit="return confirm('Disconnect this AWS account from CloudDesk? This will not delete AWS resources.');"
                            >
                                {% csrf_token %}
                                <input
                                    type="hidden"
                                    name="connection_id"
                                    value="{{ aws_connection.id }}"
                                >
                                <button type="submit" class="disconnect-button">
                                    Disconnect
                                </button>
                            </form>

                        {% else %}

                            <a href="{% url 'aws_connect' %}" class="button">
                                Connect
                            </a>

                        {% endif %}

                    </div>



                    <!-- GCP -->

                    <div class="cloud-account">

                        <div class="cloud-left">

                            <div class="cloud-icon">
                                🟢
                            </div>


                            <div>

                                <div class="cloud-name">
                                    Google Cloud Platform
                                </div>

                                <div class="cloud-info">
                                    {% if gcp_connection %}
                                        Project ID: {{ gcp_connection.project_id }}
                                    {% else %}
                                        Ready to connect
                                    {% endif %}
                                </div>

                            </div>

                        </div>


                        
                                {% if gcp_connection %}
                            <form
                                method="post"
                                action="{% url 'gcp_disconnect' %}"
                                class="disconnect-form"
                                onsubmit="return confirm('Disconnect this GCP project from CloudDesk? This will not delete GCP resources.');"
                            >
                                {% csrf_token %}
                                <input
                                    type="hidden"
                                    name="connection_id"
                                    value="{{ gcp_connection.id }}"
                                >
                                <button type="submit" class="disconnect-button">
                                    Disconnect
                                </button>
                            </form>
                        {% else %}
                            <a href="{% url 'gcp_connect' %}" class="button">
                                Connect
                            </a>
                        {% endif %}

                    </div>


                </div>



                <!-- =================================
                     AWS INFORMATION
                ================================== -->

                {% if aws_connection %}

                <div class="card">

                    <div class="card-header">

                        <h2>
                            AWS Account
                        </h2>

                        <span class="status connected">
                            ● Connected
                        </span>

                    </div>


                    <div class="aws-details">


                        <div class="aws-detail">

                            <small>
                                Account Name
                            </small>

                            <strong>
                                {{ aws_connection.name }}
                            </strong>

                        </div>


                        <div class="aws-detail">

                            <small>
                                Account ID
                            </small>

                            <strong>
                                {{ aws_connection.account_id }}
                            </strong>

                        </div>


                        <div class="aws-detail">

                            <small>
                                Region
                            </small>

                            <strong>
                                {{ aws_connection.region }}
                            </strong>

                        </div>


                    </div>

                </div>


                <!-- =================================
                     AWS SERVICES
                ================================== -->

                <div class="card">

                    <div class="card-header">
                        <h2>AWS Services</h2>
                        <span>Live from your account</span>
                    </div>

                    <div class="service-grid">

                        <!-- EC2 -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>🖥️ EC2 Instances</h4>
                                {% if aws_summary.ec2.ok %}
                                    <span class="service-count">{{ aws_summary.ec2.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if aws_summary.ec2.ok %}
                                {% if aws_summary.ec2.data %}
                                    <ul class="service-list">
                                        {% for i in aws_summary.ec2.data %}
                                            <li style="display:block;">
                                                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                                                    <span class="service-item-name">{{ i.name }}</span>
                                                    <span class="state-pill state-{{ i.state }}">{{ i.state }}</span>
                                                </div>
                                                <div class="service-actions">
                                                    {% if i.state|lower == "stopped" %}
                                                        <button type="button"
                                                                class="service-action-btn service-action-success"
                                                                onclick="openPinModal('ec2', 'start', '{{ i.id|escapejs }}', '{{ i.name|escapejs }}')">
                                                            Start
                                                        </button>
                                                        <button type="button"
                                                                class="service-action-btn service-action-danger"
                                                                onclick="openPinModal('ec2', 'terminate', '{{ i.id|escapejs }}', '{{ i.name|escapejs }}')">
                                                            Terminate
                                                        </button>
                                                    {% elif i.state|lower == "running" %}
                                                        <button type="button"
                                                                class="service-action-btn"
                                                                onclick="openPinModal('ec2', 'stop', '{{ i.id|escapejs }}', '{{ i.name|escapejs }}')">
                                                            Stop
                                                        </button>
                                                        <button type="button"
                                                                class="service-action-btn service-action-danger"
                                                                onclick="openPinModal('ec2', 'terminate', '{{ i.id|escapejs }}', '{{ i.name|escapejs }}')">
                                                            Terminate
                                                        </button>
                                                    {% elif i.state|lower == "pending" or i.state|lower == "stopping" or i.state|lower == "shutting-down" %}
                                                        <span style="font-size:13px; opacity:.75;">Action unavailable while instance is transitioning.</span>
                                                    {% endif %}
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No EC2 instances found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ aws_summary.ec2.error }}</div>
                            {% endif %}
                        </div>

                        <!-- S3 -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>🪣 S3 Buckets</h4>
                                {% if aws_summary.s3.ok %}
                                    <span class="service-count">{{ aws_summary.s3.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if aws_summary.s3.ok %}
                                {% if aws_summary.s3.data %}
                                    <ul class="service-list">
                                        {% for b in aws_summary.s3.data %}
                                            <li style="display:block;">
                                                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                                                    <span class="service-item-name">{{ b.name }}</span>
                                                    <span class="service-item-meta">{{ b.created }}</span>
                                                </div>
                                                <div class="service-actions">
                                                    <button type="button"
                                                            class="service-action-btn service-action-danger"
                                                            onclick="openPinModal('s3', 'delete', '{{ b.name|escapejs }}', '{{ b.name|escapejs }}')">
                                                        Delete
                                                    </button>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No S3 buckets found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ aws_summary.s3.error }}</div>
                            {% endif %}
                        </div>

                        <!-- RDS -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>🗄️ RDS Databases</h4>
                                {% if aws_summary.rds.ok %}
                                    <span class="service-count">{{ aws_summary.rds.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if aws_summary.rds.ok %}
                                {% if aws_summary.rds.data %}
                                    <ul class="service-list">
                                        {% for d in aws_summary.rds.data %}
                                            <li style="display:block;">
                                                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                                                    <span class="service-item-name">{{ d.id }}</span>
                                                    <span class="state-pill state-{{ d.status }}">{{ d.status }}</span>
                                                </div>
                                                <div class="service-actions">
                                                    <button type="button"
                                                            class="service-action-btn service-action-success"
                                                            onclick="openPinModal('rds', 'start', '{{ d.id|escapejs }}', '{{ d.id|escapejs }}')">
                                                        Start
                                                    </button>
                                                    <button type="button"
                                                            class="service-action-btn"
                                                            onclick="openPinModal('rds', 'stop', '{{ d.id|escapejs }}', '{{ d.id|escapejs }}')">
                                                        Stop
                                                    </button>
                                                    <button type="button"
                                                            class="service-action-btn service-action-danger"
                                                            onclick="openPinModal('rds', 'delete', '{{ d.id|escapejs }}', '{{ d.id|escapejs }}')">
                                                        Delete
                                                    </button>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No RDS instances found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ aws_summary.rds.error }}</div>
                            {% endif %}
                        </div>

                        <!-- Lambda -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>⚡ Lambda Functions</h4>
                                {% if aws_summary.lambda.ok %}
                                    <span class="service-count">{{ aws_summary.lambda.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if aws_summary.lambda.ok %}
                                {% if aws_summary.lambda.data %}
                                    <ul class="service-list">
                                        {% for f in aws_summary.lambda.data %}
                                            <li style="display:block;">
                                                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                                                    <span class="service-item-name">{{ f.name }}</span>
                                                    <span class="service-item-meta">{{ f.runtime }}</span>
                                                </div>
                                                <div class="service-actions">
                                                    <button type="button"
                                                            class="service-action-btn service-action-danger"
                                                            onclick="openPinModal('lambda', 'delete', '{{ f.name|escapejs }}', '{{ f.name|escapejs }}')">
                                                        Delete
                                                    </button>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No Lambda functions found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ aws_summary.lambda.error }}</div>
                            {% endif %}
                        </div>

                        <!-- VPC -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>🌐 VPCs</h4>
                                {% if aws_summary.vpc.ok %}
                                    <span class="service-count">{{ aws_summary.vpc.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if aws_summary.vpc.ok %}
                                {% if aws_summary.vpc.data %}
                                    <ul class="service-list">
                                        {% for v in aws_summary.vpc.data %}
                                            <li style="display:block;">
                                                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                                                    <span class="service-item-name">{{ v.id }}</span>
                                                    <span class="service-item-meta">{{ v.cidr }}</span>
                                                </div>
                                                <div class="service-actions">
                                                    <button type="button"
                                                            class="service-action-btn service-action-danger"
                                                            onclick="openPinModal('vpc', 'delete', '{{ v.id|escapejs }}', '{{ v.id|escapejs }}')">
                                                        Delete
                                                    </button>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No VPCs found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ aws_summary.vpc.error }}</div>
                            {% endif %}
                        </div>

                        <!-- IAM -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>👤 IAM Users</h4>
                                {% if aws_summary.iam.ok %}
                                    <span class="service-count">{{ aws_summary.iam.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if aws_summary.iam.ok %}
                                {% if aws_summary.iam.data %}
                                    <ul class="service-list">
                                        {% for u in aws_summary.iam.data %}
                                            <li style="display:block;">
                                                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                                                    <span class="service-item-name">{{ u.name }}</span>
                                                    <span class="service-item-meta">{{ u.created }}</span>
                                                </div>
                                                <div class="service-actions">
                                                    <button type="button"
                                                            class="service-action-btn service-action-danger"
                                                            onclick="openPinModal('iam', 'delete', '{{ u.name|escapejs }}', '{{ u.name|escapejs }}')">
                                                        Delete
                                                    </button>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No IAM users found.</div>
                                {% endif %}
                            {% else %}

                            <div class="service-box-header">
                                <h4>🖥️ Compute Engine</h4>
                                {% if gcp_summary.compute.ok %}
                                    <span class="service-count">{{ gcp_summary.compute.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if gcp_summary.compute.ok %}
                                {% if gcp_summary.compute.data %}
                                    <ul class="service-list">
                                        {% for item in gcp_summary.compute.data %}
                                            <li>
                                                <span class="service-item-name">{{ item.name }}</span>
                                                <span class="service-item-meta">{{ item.zone }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No Compute Engine instances found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ gcp_summary.compute.error }}</div>
                            {% endif %}
                        </div>

                        <!-- Cloud Storage -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>🪣 Cloud Storage</h4>
                                {% if gcp_summary.storage.ok %}
                                    <span class="service-count">{{ gcp_summary.storage.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if gcp_summary.storage.ok %}
                                {% if gcp_summary.storage.data %}
                                    <ul class="service-list">
                                        {% for item in gcp_summary.storage.data %}
                                            <li>
                                                <span class="service-item-name">{{ item.name }}</span>
                                                <span class="service-item-meta">{{ item.location }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No Cloud Storage buckets found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ gcp_summary.storage.error }}</div>
                            {% endif %}
                        </div>

                        <!-- Cloud SQL -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>🗄️ Cloud SQL</h4>
                                {% if gcp_summary.sql.ok %}
                                    <span class="service-count">{{ gcp_summary.sql.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if gcp_summary.sql.ok %}
                                {% if gcp_summary.sql.data %}
                                    <ul class="service-list">
                                        {% for item in gcp_summary.sql.data %}
                                            <li>
                                                <span class="service-item-name">{{ item.name }}</span>
                                                <span class="state-pill state-{{ item.state|lower }}">{{ item.state }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No Cloud SQL instances found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ gcp_summary.sql.error }}</div>
                            {% endif %}
                        </div>

                        <!-- Cloud Functions -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>⚡ Cloud Functions</h4>
                                {% if gcp_summary.functions.ok %}
                                    <span class="service-count">{{ gcp_summary.functions.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if gcp_summary.functions.ok %}
                                {% if gcp_summary.functions.data %}
                                    <ul class="service-list">
                                        {% for item in gcp_summary.functions.data %}
                                            <li>
                                                <span class="service-item-name">{{ item.name }}</span>
                                                <span class="service-item-meta">{{ item.state }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No Cloud Functions found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ gcp_summary.functions.error }}</div>
                            {% endif %}
                        </div>

                        <!-- VPC Networks -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>🌐 VPC Networks</h4>
                                {% if gcp_summary.vpc.ok %}
                                    <span class="service-count">{{ gcp_summary.vpc.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if gcp_summary.vpc.ok %}
                                {% if gcp_summary.vpc.data %}
                                    <ul class="service-list">
                                        {% for item in gcp_summary.vpc.data %}
                                            <li>
                                                <span class="service-item-name">{{ item.name }}</span>
                                                <span class="service-item-meta">{{ item.cidr }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No VPC networks found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ gcp_summary.vpc.error }}</div>
                            {% endif %}
                        </div>

                        <!-- IAM -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>👤 IAM Service Accounts</h4>
                                {% if gcp_summary.iam.ok %}
                                    <span class="service-count">{{ gcp_summary.iam.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if gcp_summary.iam.ok %}
                                {% if gcp_summary.iam.data %}
                                    <ul class="service-list">
                                        {% for item in gcp_summary.iam.data %}
                                            <li>
                                                <span class="service-item-name">{{ item.name }}</span>
                                                <span class="service-item-meta">{{ item.email }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No IAM service accounts found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ gcp_summary.iam.error }}</div>
                            {% endif %}
                        </div>

                        <!-- Cloud Monitoring -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>📈 Cloud Monitoring</h4>
                                {% if gcp_summary.monitoring.ok %}
                                    <span class="service-count">{{ gcp_summary.monitoring.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if gcp_summary.monitoring.ok %}
                                {% if gcp_summary.monitoring.data %}
                                    <ul class="service-list">
                                        {% for item in gcp_summary.monitoring.data %}
                                            <li>
                                                <span class="service-item-name">{{ item.name }}</span>
                                                <span class="state-pill state-{{ item.state|lower }}">{{ item.state }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No monitoring alert policies found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ gcp_summary.monitoring.error }}</div>
                            {% endif %}
                        </div>

                    </div>

                </div>

                {% else %}

                <div class="card">
                    <div class="card-header">
                        <h2>Google Cloud Platform</h2>
                        <a href="{% url 'gcp_connect' %}" class="button">Connect</a>
                    </div>
                    <div class="cloud-info">
                        No GCP project connected. Connect a GCP project to view its services.
                    </div>
                </div>

                {% endif %}

                {% endif %}


            </div>



            <!-- =================================
                 RIGHT SIDE
            ================================== -->

            <div>


                <!-- PROFILE -->

                <div class="card">

                    <div class="card-header">

                        <h2>
                            Profile
                        </h2>

                    </div>


                    <div class="profile-row">

                        <span class="profile-label">
                            Name
                        </span>

                        <span class="profile-value">
                            {{ profile.name }}
                        </span>

                    </div>


                    <div class="profile-row">

                        <span class="profile-label">
                            Username
                        </span>

                        <span class="profile-value">
                            {{ profile.username }}
                        </span>

                    </div>


                    <div class="profile-row">

                        <span class="profile-label">
                            Email
                        </span>

                        <span class="profile-value">
                            {{ profile.email }}
                        </span>

                    </div>

                </div>



                <!-- ALERTS -->

                <div class="card">

                    <div class="card-header">

                        <h2>
                            🔔 Alerts
                        </h2>

                        <span>
                            {{ alerts|length }}
                        </span>

                    </div>


                    {% if alerts %}

                        {% for alert in alerts %}

                            <div class="alert">

                                <div class="alert-title">
                                    {{ alert.title }}
                                </div>

                                <div class="alert-message">
                                    {{ alert.message }}
                                </div>

                            </div>

                        {% endfor %}

                    {% else %}

                        <div class="no-alerts">
                            ✓ No new alerts
                        </div>

                    {% endif %}

                </div>


            </div>


        </div>


    </main>


</div>


</body>

    
    <!-- Email OTP confirmation modal -->
    <div
        id="otpModal"
        class="pin-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="otpModalTitle"
    >
        <div class="pin-modal-card">

            <h3 id="otpModalTitle">
                Verify this action
            </h3>

            <p id="otpModalDesc" class="pin-modal-desc">
                A 6-digit verification code will be sent to your email.
            </p>

            <div
                id="otpModalEmail"
                style="font-size:12px; color:#374151; margin-bottom:12px;"
            ></div>

            <input
                type="text"
                id="otpModalCode"
                class="pin-modal-password"
                placeholder="Enter 6-digit OTP"
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength="6"
                style="display:none;"
            >

            <div id="otpModalError" class="pin-modal-error"></div>

            <div
                id="otpModalInfo"
                style="font-size:11px; color:#6b7280; margin-bottom:12px;"
            >
                Click Send OTP to receive a 6-digit code on your registered email.
            </div>

            <div class="pin-modal-buttons">

                <button
                    type="button"
                    onclick="closeOtpModal()"
                    class="pin-modal-btn pin-modal-cancel"
                >
                    Cancel
                </button>

                <button
                    type="button"
                    id="otpSendButton"
                    onclick="sendActionOtp()"
                    class="pin-modal-btn pin-modal-confirm"
                >
                    Send OTP
                </button>

            </div>

        </div>
    </div>

    <script>
        let pendingAction = null;

        function getCsrfToken() {
            const cookie = document.cookie
                .split("; ")
                .find(row => row.startsWith("csrftoken="));

            return cookie
                ? decodeURIComponent(cookie.split("=")[1])
                : "";
        }

        function openPinModal(service, action, resourceId, label) {
            pendingAction = {
                service: service,
                action: action,
                resourceId: resourceId,
                label: label
            };

            document.getElementById("otpModalDesc").textContent =
                `Verify your email before you ${action} ${label}.`;

            document.getElementById("otpModalEmail").textContent =
                "The OTP will be sent to your registered CloudDesk email.";

            const codeInput = document.getElementById("otpModalCode");
            codeInput.value = "";
            codeInput.style.display = "none";
            document.getElementById("otpModalError").textContent = "";

            const sendButton = document.getElementById("otpSendButton");
            sendButton.textContent = "Send OTP";
            sendButton.disabled = false;

            document.getElementById("otpModalInfo").textContent =
                "Click Send OTP to receive a 6-digit code on your registered email.";

            document.getElementById("otpModal").style.display = "flex";
        }

        function closeOtpModal() {
            document.getElementById("otpModal").style.display = "none";
            const codeInput = document.getElementById("otpModalCode");
            codeInput.value = "";
            codeInput.style.display = "none";
            document.getElementById("otpModalError").textContent = "";
            pendingAction = null;
        }

        async function sendActionOtp() {
            if (!pendingAction) return;

            const button = document.getElementById("otpSendButton");
            const errorBox = document.getElementById("otpModalError");

            button.disabled = true;
            errorBox.textContent = "";

            const formData = new FormData();
            formData.append("service", pendingAction.service);
            formData.append("action", pendingAction.action);
            formData.append("resource_id", pendingAction.resourceId);

            try {
                const response = await fetch(
                    "{% url 'send_action_otp' %}",
                    {
                        method: "POST",
                        headers: {
                            "X-CSRFToken": getCsrfToken(),
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        credentials: "same-origin",
                        body: formData
                    }
                );

                const result = await response.json();

                if (response.ok && result.ok) {
                    button.textContent = "Verify OTP";
                    button.onclick = verifyActionOtp;
                    button.disabled = false;

                    const codeInput = document.getElementById("otpModalCode");
                    codeInput.style.display = "block";
                    codeInput.value = "";

                    document.getElementById("otpModalDesc").textContent =
                        result.message ||
                        "OTP sent. Enter the 6-digit code to continue.";

                    document.getElementById("otpModalInfo").textContent =
                        "OTP expires in 5 minutes.";

                    codeInput.focus();
                    return;
                }

                errorBox.textContent =
                    result.error || "Could not send OTP.";

                button.disabled = false;

            } catch (error) {
                errorBox.textContent =
                    "Network error. Try again.";

                button.disabled = false;
            }
        }

        async function verifyActionOtp() {
            if (!pendingAction) return;

            const codeInput = document.getElementById("otpModalCode");
            const errorBox = document.getElementById("otpModalError");
            const button = document.getElementById("otpSendButton");

            const otp = codeInput.value.trim();

            if (!/^\d{6}$/.test(otp)) {
                errorBox.textContent =
                    "Please enter the 6-digit OTP.";
                codeInput.focus();
                return;
            }

            button.disabled = true;
            errorBox.textContent = "";

            const formData = new FormData();
            formData.append("otp", otp);

            try {
                const response = await fetch(
                    "{% url 'verify_action_otp' %}",
                    {
                        method: "POST",
                        headers: {
                            "X-CSRFToken": getCsrfToken(),
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        credentials: "same-origin",
                        body: formData
                    }
                );

                const result = await response.json();

                if (response.ok && result.ok) {
                    closeOtpModal();
                    location.reload();
                    return;
                }

                errorBox.textContent =
                    result.error || "OTP verification failed.";

                button.disabled = false;

            } catch (error) {
                errorBox.textContent =
                    "Network error. Try again.";

                button.disabled = false;
            }
        }

        document.getElementById("otpModalCode").addEventListener(
            "input",
            function() {
                this.value = this.value.replace(/\D/g, "").slice(0, 6);
            }
        );

        document.getElementById("otpModalCode").addEventListener(
            "keydown",
            function(event) {
                if (event.key === "Enter") {
                    verifyActionOtp();
                }

                if (event.key === "Escape") {
                    closeOtpModal();
                }
            }
        );

        document.getElementById("otpModal").addEventListener(
            "click",
            function(event) {
                if (event.target === this) {
                    closeOtpModal();
                }
            }
        );
    </script>

</body>
</html>

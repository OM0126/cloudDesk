                            {% endif %}
                        </div>

                        <!-- CloudWatch -->
                        <div class="service-box">
                            <div class="service-box-header">
                                <h4>📈 CloudWatch Alarms</h4>
                                {% if aws_summary.cloudwatch.ok %}
                                    <span class="service-count">{{ aws_summary.cloudwatch.data|length }}</span>
                                {% endif %}
                            </div>

                            {% if aws_summary.cloudwatch.ok %}
                                {% if aws_summary.cloudwatch.data %}
                                    <ul class="service-list">
                                        {% for a in aws_summary.cloudwatch.data %}
                                            <li style="display:block;">
                                                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                                                    <span class="service-item-name">{{ a.name }}</span>
                                                    <span class="state-pill state-{{ a.state|lower }}">{{ a.state }}</span>
                                                </div>
                                                <div class="service-actions">
                                                    <button type="button"
                                                            class="service-action-btn service-action-danger"
                                                            onclick="openPinModal('cloudwatch', 'delete', '{{ a.name|escapejs }}', '{{ a.name|escapejs }}')">
                                                        Delete
                                                    </button>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <div class="service-empty">No alarms found.</div>
                                {% endif %}
                            {% else %}
                                <div class="service-error">{{ aws_summary.cloudwatch.error }}</div>
                            {% endif %}
                        </div>

                    </div>

                </div>


                <!-- =================================
                     GCP INFORMATION
                ================================== -->

                {% if gcp_connection %}

                <div class="card">

                    <div class="card-header">
                        <h2>
                            Google Cloud Platform
                        </h2>

                        <span class="status connected">
                            ● Connected
                        </span>
                    </div>

                    <div class="aws-details">

                        <div class="aws-detail">
                            <small>Account Name</small>
                            <strong>{{ gcp_connection.name }}</strong>
                        </div>

                        <div class="aws-detail">
                            <small>Project ID</small>
                            <strong>{{ gcp_connection.project_id }}</strong>
                        </div>

                        <div class="aws-detail">
                            <small>Project Name</small>
                            <strong>{{ gcp_connection.project_name|default:"-" }}</strong>
                        </div>

                    </div>

                </div>


                <!-- =================================
                     GCP SERVICES
                ================================== -->

                <div class="card">

                    <div class="card-header">
                        <h2>GCP Services</h2>
                        <span>Live from your project</span>
                    </div>

                    <div class="service-grid">

                        <!-- Compute Engine -->
